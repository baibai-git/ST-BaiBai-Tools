{
  "name": "sillytavern-baibai-toolkit",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:preset-backup-retention": "node --experimental-vm-modules --test scripts/test-preset-backup-retention.mjs",
    "test:generate-retry": "node --experimental-vm-modules --test scripts/test-generate-blacklist-retry.mjs",
    "test:preset-search": "node --experimental-vm-modules --test scripts/test-preset-entry-search.mjs",
    "test:pen": "vitest run",
    "typecheck:pen": "vue-tsc --noEmit -p tsconfig.json",
    "sync-version": "node scripts/sync-version.mjs",
    "prebuild": "node scripts/sync-version.mjs",
    "build": "vite build --mode production",
    "prewatch": "node scripts/sync-version.mjs",
    "watch": "vite build --watch --mode development"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.8.0",
    "eslint-scope": "^9.1.2",
    "espree": "^11.2.0",
    "globals": "^17.7.0",
    "magic-string": "^1.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.1",
    "jsonrepair": "^3.15.0",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.45",
    "vue-draggable-next": "^2.3.0"
  }
}
